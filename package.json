{
  "name": "fin-dev-test",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "wasm-pack build wasm-producer --target web --out-dir ../public/wasm --out-name producer",
    "start": "npm run build:wasm && ng serve",
    "build": "npm run build:wasm && ng build",
    "watch": "npm run build:wasm && ng build --watch --configuration development",
    "test": "npm run build:wasm && ng test",
    "lint": "ng lint",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
